---
import {sitePath} from '../../lib/paths';
import Layout from '../../layouts/Layout.astro';
import {Image} from 'astro:assets';
import {fabrics,sourceImage} from '../../lib/catalog';
import {text,locales} from '../../lib/i18n';
import type {Locale} from '../../lib/types';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;
---
<Layout lang={lang} title={text(lang,'실크 & 컬러','Silk & color')}>
  <div class="section-wrap page-intro">
    <span class="eyebrow">THE COLOR LIBRARY</span>
    <h1>{text(lang,'나만의 색을 찾는 시간','Find your kind of color')}</h1>
    <p>{text(lang,
      '수저우와 루비, 두 가지 프리미엄 실크에서 시작되는 나만의 선택.\n화면과 조명에 따라 색이 다르게 보일 수 있으니, 정확한 색상 코드는 미셸과 상담 시 확인해 주세요.',
      'Your choice begins with Suzhou or Ruby silk.\nScreens and lighting can change how colors appear. Confirm the exact shade with Michelle.'
    )}</p>
  </div>

  <div class="section-wrap fabrics-page">
    {fabrics.map(fabric => {
      const fName = fabric.name[lang] || fabric.name.en || fabric.name.ko;
      const fDesc = fabric.description[lang] || fabric.description.en || fabric.description.ko;
      const isSuzhou = fabric.id === 'suzhou';
      
      const chartImg = `assets/fabrics/${fabric.id}/chart-ko.jpg`;

      return (
        <section class="fabric-library" id={fabric.id}>
          <div class="fabric-library-heading">
            <span class="eyebrow">{fabric.id.toUpperCase()} SILK · {isSuzhou ? text(lang, '수저우 실크', 'Suzhou Silk') : text(lang, '루비 실크', 'Ruby Silk')}</span>
            <h2>{fName}</h2>
            <p>{fDesc}</p>
          </div>

          <!-- Color Swatches Grid -->
          {fabric.colors.length > 0 && (
            <div class="color-library">
              {fabric.colors.map(color => {
                const cName = color.name[lang] || color.name.en || color.name.ko;
                return (
                  <div class="color-tile">
                    <span style={`background:${color.hex}`}></span>
                    <b>{cName}</b>
                    <small>No. {color.code}</small>
                  </div>
                );
              })}
            </div>
          )}

          <!-- Single Official High-Resolution Color Chart -->
          <div class="chart-section">
            <div class="chart-section-title">
              <h3>{text(lang, '공식 컬러차트 (고해상도 2048px)', 'Official Color Chart (High-Res 2048px)')}</h3>
              <p class="muted">
                {text(lang,
                  '확대하여 원단의 미세한 광택과 톤을 확인해 보세요.',
                  'Zoom in to inspect the fine texture and sheen.'
                )}
              </p>
            </div>

            <div class="chart-single-wrap">
              <figure class="chart-card">
                <Image src={sourceImage(chartImg)} width={1400} format="webp" alt={`${fName} color chart`} loading="lazy"/>
                <figcaption>{isSuzhou ? text(lang, '수저우 실크 프리미엄 컬러차트', 'Suzhou Silk Premium Color Chart') : text(lang, '루비 실크 프리미엄 컬러차트', 'Ruby Silk Premium Color Chart')}</figcaption>
              </figure>
            </div>
          </div>
        </section>
      );
    })}

    <!-- Fabric Characteristics Comparison -->
    <section class="fabric-characteristics-section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">FABRIC GUIDE</span>
          <h2>{text(lang, '두 가지 실크의 특별한 매력', 'The Unique Appeal of Two Silks')}</h2>
        </div>
      </div>
      <div class="fabric-compare-grid">
        <div class="compare-card">
          <span class="compare-badge">SUZHOU SILK</span>
          <h3>{text(lang, '수저우 실크 (Suzhou Silk)', 'Suzhou Silk')}</h3>
          <p class="compare-lead">{text(lang, '은은한 광택과 극상의 부드러움', 'Subtle sheen & supreme softness')}</p>
          <ul class="compare-list">
            <li>{text(lang, '피부에 닿는 촉감이 극도로 부드럽고 쾌적하여 한 겹으로 착용 시에도 편안합니다.', 'Exceptionally gentle and pleasant on skin, ideal even in a single layer.')}</li>
            <li>{text(lang, '세탁 후 스팀 다리미로 살짝만 다려주면 주름이 쉽게 펴집니다 (손세탁 시 다림질 거의 불필요).', 'Restores easily with light steaming; hand washing rarely requires ironing.')}</li>
          </ul>
        </div>
        <div class="compare-card">
          <span class="compare-badge">RUBY SILK</span>
          <h3>{text(lang, '루비 실크 (Ruby Silk)', 'Ruby Silk')}</h3>
          <p class="compare-lead">{text(lang, '선명한 광택감과 탄탄한 실루엣 유지', 'Lustrous sheen & structured drape')}</p>
          <ul class="compare-list">
            <li>{text(lang, '원단이 힘이 있고 도톰하여 완벽한 드레스 실루엣을 오랫동안 유지해 줍니다.', 'Substantial body and structured drape that keeps tailored silhouettes intact.')}</li>
            <li>{text(lang, '구김이 거의 가지 않아 관리가 편리하며, 퓨어 화이트 등 극도로 밝은 색상에만 2겹 제작을 추천합니다.', 'Wrinkle-resistant. 2-layer lining is only advised for pure white; others look stunning in single layer.')}</li>
          </ul>
        </div>
      </div>
    </section>

    <div class="fabric-action-footer">
      <a class="button primary" href={sitePath(`/${lang}/#collection`)}>
        {text(lang,'컬렉션 디자인 고르기','Explore designs')} ↗
      </a>
      <a class="button secondary" href={sitePath(`/${lang}/#how-it-works`)}>
        {text(lang,'사이즈 맞춤 안내','Made to measure guide')} ↗
      </a>
    </div>
  </div>
</Layout>
