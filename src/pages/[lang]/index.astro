  <!-- CLIENT-SIDE SCRIPT FOR HERO AUTO-PLAY & HORIZONTAL PRODUCT SEARCH -->
  <script>
    // 1. Auto-sliding Hero Carousel
    const heroTrack = document.getElementById('heroTrack');
    const heroSlides = document.querySelectorAll('.hero-slide');
    const heroIndicators = document.querySelectorAll('.hero-indicator-btn');
    const heroPrevBtn = document.getElementById('heroPrevBtn');
    const heroNextBtn = document.getElementById('heroNextBtn');
    const heroCarousel = document.getElementById('heroCarousel');

    let currentHeroSlide = 0;
    const totalHeroSlides = heroSlides.length;
    let heroAutoTimer: number | undefined;

    function goToHeroSlide(index: number) {
      if (totalHeroSlides === 0) return;
      currentHeroSlide = (index + totalHeroSlides) % totalHeroSlides;
      if (heroTrack) {
        heroTrack.style.transform = `translateX(-${currentHeroSlide * 100}%)`;
      }
      heroIndicators.forEach((btn, idx) => {
        btn.classList.toggle('active', idx === currentHeroSlide);
      });
    }

    function startHeroAutoPlay() {
      stopHeroAutoPlay();
      heroAutoTimer = window.setInterval(() => {
        goToHeroSlide(currentHeroSlide + 1);
      }, 4500);
    }

    function stopHeroAutoPlay() {
      if (heroAutoTimer) {
        clearInterval(heroAutoTimer);
        heroAutoTimer = undefined;
      }
    }

    heroPrevBtn?.addEventListener('click', () => {
      goToHeroSlide(currentHeroSlide - 1);
      startHeroAutoPlay();
    });

    heroNextBtn?.addEventListener('click', () => {
      goToHeroSlide(currentHeroSlide + 1);
      startHeroAutoPlay();
    });

    heroIndicators.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = Number(btn.getAttribute('data-index') || 0);
        goToHeroSlide(idx);
        startHeroAutoPlay();
      });
    });

    heroCarousel?.addEventListener('mouseenter', stopHeroAutoPlay);
    heroCarousel?.addEventListener('mouseleave', startHeroAutoPlay);

    // Touch swipe for Hero
    let heroTouchStart = 0;
    heroCarousel?.addEventListener('touchstart', (e: TouchEvent) => {
      heroTouchStart = e.changedTouches[0].screenX;
      stopHeroAutoPlay();
    }, { passive: true });

    heroCarousel?.addEventListener('touchend', (e: TouchEvent) => {
      const heroTouchEnd = e.changedTouches[0].screenX;
      const diff = heroTouchStart - heroTouchEnd;
      if (Math.abs(diff) > 40) {
        if (diff > 0) goToHeroSlide(currentHeroSlide + 1);
        else goToHeroSlide(currentHeroSlide - 1);
      }
      startHeroAutoPlay();
    }, { passive: true });

    startHeroAutoPlay();

    // 2. Collection Search, Filter, Grid/Scroll View & Expand All
    const searchInput = document.getElementById('collectionSearchInput') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clearSearchBtn') as HTMLButtonElement | null;
    const resetSearchBtn = document.getElementById('resetSearchBtn') as HTMLButtonElement | null;
    const emptyState = document.getElementById('searchEmptyState') as HTMLElement | null;
    const productCards = document.querySelectorAll<HTMLElement>('.product-card');
    const countLabel = document.querySelector('[data-visible-count]');
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const track = document.getElementById('productTrack');
    const scrollSection = document.getElementById('horizontalScrollSection');
    const scrollPrevBtn = document.getElementById('scrollPrevBtn') as HTMLButtonElement | null;
    const scrollNextBtn = document.getElementById('scrollNextBtn') as HTMLButtonElement | null;
    const scrollThumb = document.getElementById('scrollIndicatorThumb') as HTMLElement | null;
    const viewButtons = document.querySelectorAll<HTMLButtonElement>('[data-view]');
    const expandWrapper = document.getElementById('collectionExpandWrapper') as HTMLElement | null;
    const toggleDesignsBtn = document.getElementById('toggleAllDesignsBtn') as HTMLButtonElement | null;
    const toggleDesignsText = document.getElementById('toggleAllDesignsText') as HTMLElement | null;

    let activeCategory = 'all';
    let searchQuery = '';
    let currentView = 'grid'; // Grid is active by default
    let isExpanded = false;
    const INITIAL_VISIBLE_COUNT = 16;
    const totalDesigns = productCards.length;

    // Text normalizer: removes accents/diacritics, spaces, hyphens for flexible search matching
    function normalizeKeyword(str: string): string {
      return (str || '')
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .normalize('NFC')
        .replace(/[^a-z0-9가-힣]/g, '');
    }

    // Category synonyms mapping
    const categorySynonyms: Record<string, string[]> = {
      dress: ['dress', 'dresses', '드레스', '원피스', 'slip', 'gown', 'party', '파티', 'halter', 'plunge', 'basic', '캐미', '슬립', '베이직'],
      top: ['top', 'tops', 'blouse', 'blouses', 'tank top', '탱크탑', '나시', '탑', '블라우스', '셔츠', '긴소매', '긴팔', '기성복'],
      trouser: ['trouser', 'trousers', 'pants', '바지', '슬랙스', '팬츠', 'shorts', 'short', '쇼츠', '숏팬츠'],
      sleepwear: ['sleepwear', 'pajama', 'pajamas', 'nightwear', '슬립웨어', '잠옷', '파자마', 'tank top', 'cami', 'shorts', 'camisole'],
      loungewear: ['loungewear', 'homewear', 'lounge', 'home', '라운지웨어', '홈웨어', '실내복', 'cowl neck', 'flare', 'flared', 'set', '투피스', '셋업', '스커트 셋업'],
      skirt: ['skirt', 'skirts', '스커트', '치마', '플레어 스커트', 'A라인', '머메이드', '피쉬테일', '미니 스커트', '미니', 'mini skirt', 'mini', 'maxi skirt', 'flared skirt', 'a line', 'a-line', 'mermaid', 'fishtail', 'suzhou', 'ruby', 'h-line', 'h라인', 'h 라인']
    };

    function applyFilterAndSearch() {
      const rawQ = searchQuery.trim().toLowerCase();
      const tokens = rawQ.split(/\s+/).filter(Boolean);
      const isFiltered = (activeCategory !== 'all') || (tokens.length > 0);
      let matchedCount = 0;
      let displayedCount = 0;

      productCards.forEach(card => {
        const cat = (card.dataset.category || '').toLowerCase();
        const id = (card.dataset.id || '').toLowerCase();
        const slug = (card.dataset.slug || '').toLowerCase();
        const nameKo = (card.dataset.nameKo || '').toLowerCase();
        const nameEn = (card.dataset.nameEn || '').toLowerCase();
        const nameVi = (card.dataset.nameVi || '').toLowerCase();
        const fabrics = (card.dataset.fabrics || '').toLowerCase();

        // 1. Category filter
        let matchesCategory = false;
        if (activeCategory === 'all') {
          matchesCategory = true;
        } else if (activeCategory === 'linen') {
          matchesCategory = slug.includes('linen') || id.includes('ml-31') || id.includes('ml-32') || id.includes('ml-33') || id.includes('ml-34');
        } else {
          matchesCategory = (cat === activeCategory);
        }

        // 2. Query search
        let matchesQuery = true;
        if (tokens.length > 0) {
          const normId = normalizeKeyword(id);
          const normSlug = normalizeKeyword(slug);
          const normKo = normalizeKeyword(nameKo);
          const normEn = normalizeKeyword(nameEn);
          const normVi = normalizeKeyword(nameVi);
          const normFab = normalizeKeyword(fabrics);
          const synonyms = (categorySynonyms[cat] || []).map(normalizeKeyword).join(' ');

          const fullSearchable = `${id} ${slug} ${nameKo} ${nameEn} ${nameVi} ${fabrics} ${normId} ${normSlug} ${normKo} ${normEn} ${normVi} ${normFab} ${synonyms}`;

          matchesQuery = tokens.every(token => {
            const normToken = normalizeKeyword(token);
            return fullSearchable.includes(token) || (normToken.length > 0 && fullSearchable.includes(normToken));
          });
        }

        const isMatch = matchesCategory && matchesQuery;
        if (isMatch) {
          matchedCount++;
          // In Grid mode, if not expanded and no filter/search, limit to initial count (16 designs)
          const shouldShow = (currentView === 'scroll' || isFiltered || isExpanded || matchedCount <= INITIAL_VISIBLE_COUNT);
          if (shouldShow) {
            card.hidden = false;
            card.style.display = '';
            displayedCount++;
          } else {
            card.hidden = true;
            card.style.display = 'none';
          }
        } else {
          card.hidden = true;
          card.style.display = 'none';
        }
      });

      if (countLabel) countLabel.textContent = String(matchedCount);
      if (emptyState) emptyState.hidden = (matchedCount > 0);
      if (clearSearchBtn) clearSearchBtn.hidden = (rawQ.length === 0);

      // Manage expand/collapse button visibility and text
      if (expandWrapper && toggleDesignsText) {
        if (currentView === 'scroll' || isFiltered || matchedCount <= INITIAL_VISIBLE_COUNT) {
          expandWrapper.style.display = 'none';
        } else {
          expandWrapper.style.display = 'flex';
          if (isExpanded) {
            toggleDesignsText.textContent = toggleDesignsBtn?.dataset.collapseText || '간략히 보기 (처음 16개만 보기) ∧';
          } else {
            toggleDesignsText.textContent = toggleDesignsBtn?.dataset.expandText || `전체 ${totalDesigns}개 디자인 모두 보기 ∨`;
          }
        }
      }

      if (track && currentView === 'scroll') {
        track.scrollLeft = 0;
        updateScrollIndicator();
      }
    }

    // Expand / Collapse all designs click handler
    toggleDesignsBtn?.addEventListener('click', () => {
      isExpanded = !isExpanded;
      applyFilterAndSearch();
      if (!isExpanded) {
        const collElem = document.getElementById('collection');
        collElem?.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // Handle Linen nav link click
    document.querySelectorAll('[data-nav-linen]').forEach(link => {
      link.addEventListener('click', (e) => {
        if (searchInput) {
          e.preventDefault();
          activeCategory = 'linen';
          searchInput.value = '';
          searchQuery = '';
          filterButtons.forEach(btn => btn.setAttribute('aria-pressed', String(btn.dataset.filter === 'linen')));
          applyFilterAndSearch();
          const coll = document.getElementById('collection');
          if (coll) {
            coll.scrollIntoView({ behavior: 'smooth' });
          }
          try {
            const url = new URL(window.location.href);
            url.searchParams.set('q', 'linen');
            url.hash = 'collection';
            window.history.pushState({}, '', url.toString());
          } catch {}
        }
      });
    });

    // Initialize search/filter from URL query if present (e.g. ?q=linen#collection)
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const urlQuery = urlParams.get('q');
      if (urlQuery) {
        if (urlQuery.toLowerCase() === 'linen' || urlQuery === '린넨') {
          activeCategory = 'linen';
          filterButtons.forEach(btn => btn.setAttribute('aria-pressed', String(btn.dataset.filter === 'linen')));
        } else {
          searchQuery = urlQuery;
          const headerInput = document.getElementById('headerSearchInput') as HTMLInputElement | null;
          if (headerInput) headerInput.value = urlQuery;
        }
        applyFilterAndSearch();
      }
    } catch {}

    // Real-time filter synced with Header Search Bar
    window.addEventListener('michelle:search-input', (e: any) => {
      searchQuery = e.detail?.query || '';
      applyFilterAndSearch();
    });

    resetSearchBtn?.addEventListener('click', () => {
      searchQuery = '';
      const headerInput = document.getElementById('headerSearchInput') as HTMLInputElement | null;
      if (headerInput) headerInput.value = '';
      activeCategory = 'all';
      filterButtons.forEach(btn => btn.setAttribute('aria-pressed', String(btn.dataset.filter === 'all')));
      applyFilterAndSearch();
    });

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        activeCategory = btn.dataset.filter || 'all';
        filterButtons.forEach(el => el.setAttribute('aria-pressed', String(el === btn)));
        applyFilterAndSearch();
      });
    });

    // Horizontal Scroll controls
    function updateScrollIndicator() {
      if (!track || !scrollThumb) return;
      const maxScroll = track.scrollWidth - track.clientWidth;
      if (maxScroll <= 0) {
        scrollThumb.style.width = '100%';
        scrollThumb.style.transform = 'translateX(0)';
        if (scrollPrevBtn) scrollPrevBtn.disabled = true;
        if (scrollNextBtn) scrollNextBtn.disabled = true;
        return;
      }

      const ratio = track.clientWidth / track.scrollWidth;
      const thumbWidthPercent = Math.max(15, Math.min(100, ratio * 100));
      scrollThumb.style.width = `${thumbWidthPercent}%`;

      const progress = track.scrollLeft / maxScroll;
      const maxTranslatePercent = (100 - thumbWidthPercent);
      scrollThumb.style.transform = `translateX(${(progress * maxTranslatePercent).toFixed(1)}%)`;

      if (scrollPrevBtn) scrollPrevBtn.disabled = track.scrollLeft <= 5;
      if (scrollNextBtn) scrollNextBtn.disabled = track.scrollLeft >= maxScroll - 5;
    }

    track?.addEventListener('scroll', updateScrollIndicator, { passive: true });
    window.addEventListener('resize', updateScrollIndicator, { passive: true });

    scrollPrevBtn?.addEventListener('click', () => {
      if (!track) return;
      const scrollAmount = track.clientWidth * 0.75;
      track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    });

    scrollNextBtn?.addEventListener('click', () => {
      if (!track) return;
      const scrollAmount = track.clientWidth * 0.75;
      track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
    });

    // View mode toggle (Scroll vs Grid)
    viewButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const view = btn.dataset.view || 'grid';
        currentView = view;
        viewButtons.forEach(b => b.classList.toggle('active', b === btn));
        if (scrollSection) {
          scrollSection.classList.toggle('grid-view', view === 'grid');
        }
        applyFilterAndSearch();
        updateScrollIndicator();
      });
    });

    // Initial setup (run applyFilterAndSearch to set up initial grid with 16 designs)
    applyFilterAndSearch();
    updateScrollIndicator();
  </script>
</Layout>
