---
import {sitePath} from '../../lib/paths';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import {Image} from 'astro:assets';
import {getCatalog,sourceImage} from '../../lib/catalog';
import {text,locales,categoryNames} from '../../lib/i18n';
import type {Locale} from '../../lib/types';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;
const catalog=await getCatalog();

// 4 high-fashion model designs for the auto-sliding hero
const heroSlugs = [
  'minimal-cowl-neck-slip-dress',
  'halter-maxi',
  'scoop-neck-slip-maxi',
  'minimal-long-sleeve-cowl-neck'
];

const heroSlides = heroSlugs
  .map(slug => catalog.designs.find(d => d.slug === slug))
  .filter((d): d is typeof catalog.designs[0] => Boolean(d));

if (heroSlides.length < 4) {
  for (const d of catalog.designs) {
    if (!heroSlides.some(s => s.id === d.id)) {
      heroSlides.push(d);
      if (heroSlides.length >= 4) break;
    }
  }
}

const second = heroSlides[1] ?? catalog.designs[1];
const detail = catalog.designs.find(d => d.slug === 'slim-fit-blouse') ?? heroSlides[0];
---
<Layout lang={lang} title={text(lang,'사이즈 맞춤 실크 컬렉션','Made-to-measure silk collection')}>
  <!-- Schema.org CollectionPage & ItemList Structured Data for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": text(lang, "미셸 스토어 사이즈 맞춤 실크 컬렉션", "Michelle Store Made-to-measure Silk Collection"),
    "description": text(lang, "수저우 실크와 루비 실크로 맞춤 제작되는 미셸의 드레스, 블라우스, 트라우저 컬렉션.", "Michelle's collection of custom made-to-measure dresses, blouses, and trousers in luxury silk."),
    "url": new URL(sitePath(`/${lang}/`), Astro.site || 'https://michellestore.com').toString(),
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": catalog.designs.length,
      "itemListElement": catalog.designs.map((design, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": design.name[lang] || design.name.en,
        "url": new URL(sitePath(`/${lang}/designs/${design.slug}/`), Astro.site || 'https://michellestore.com').toString(),
        "image": new URL(design.imageUrl, Astro.site || 'https://michellestore.com').toString()
      }))
    }
  })} />

  <!-- 1. AUTO-SLIDING HERO BANNER WITH 4 MODELS -->
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">SILK, MADE TO MEASURE · {text(lang,'사이즈 맞춤 제작','BESPOKE SILK')}</span>
      <h1>
        {text(lang,'미셸의 디자인,','Michelle’s designs,')}<br/>
        {text(lang,'나에게 맞는 사이즈.','made to your size.')}
      </h1>
      <p class="hero-script">Silk, made to measure.</p>
      <p class="hero-description">
        {text(lang,
          '미셸의 컬렉션에서 디자인과 실크, 컬러를 고르세요.\n선택하신 디자인을 고객님의 신체 치수에 맞춰 제작해 드려요.',
          'Choose a design from Michelle’s collection, along with your silk and color.\nYour selected piece is made to your measurements.'
        )}
      </p>
      <div class="hero-actions">
        <a class="button primary hero-button" href="#collection">
          {text(lang,'컬렉션 살펴보기','Explore collection')}<span>↗</span>
        </a>
        <a class="button secondary hero-sub-button" href="#care-guide">
          {text(lang,'원단 관리 가이드','Fabric care guide')}
        </a>
      </div>
      <div class="hero-footnote">
        <span class="fine-line"></span>
        <span>{text(lang,'미셸의 컬렉션에서 고르고, 사이즈는 나에게 맞게','Choose from the collection. Made to your measurements.')}</span>
      </div>
    </div>
    
    <div class="hero-visual">
      <div class="hero-carousel" id="heroCarousel">
        <div class="hero-slides-track" id="heroTrack">
          {heroSlides.map((slide, idx) => (
            <a class="hero-slide" href={sitePath(`/${lang}/designs/${slide.slug}/`)} aria-label={slide.name[lang] || slide.name.en}>
              <img 
                src={slide.imageUrl} 
                width="1000" 
                height="1333" 
                fetchpriority={idx === 0 ? "high" : "auto"} 
                loading={idx === 0 ? "eager" : "lazy"} 
                alt={slide.name[lang] || slide.name.en}
              />
              <span class="photo-caption">
                <span>0{idx + 1} / {slide.name[lang] || slide.name.en}</span>
                <span>{text(lang, '디자인 보기', 'EXPLORE')} ↗</span>
              </span>
            </a>
          ))}
        </div>
        
        <button type="button" class="hero-nav-btn prev" id="heroPrevBtn" aria-label="Previous slide">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="hero-nav-btn next" id="heroNextBtn" aria-label="Next slide">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>

        <div class="hero-indicators" id="heroIndicators">
          {heroSlides.map((_, idx) => (
            <button type="button" class={`hero-indicator-btn ${idx === 0 ? 'active' : ''}`} data-index={idx} aria-label={`Slide ${idx + 1}`}>
              <span class="ind-number">0{idx + 1}</span>
              <span class="ind-bar"><span class="ind-progress"></span></span>
            </button>
          ))}
        </div>
      </div>

      <a class="hero-inset" href={sitePath(`/${lang}/designs/${second.slug}/`)}>
        <img src={second.thumbnailUrl} width="480" height="640" alt={second.name[lang] || second.name.en}/>
        <span>{text(lang,'나를 닮은 한 벌','A piece of you')} ↗</span>
      </a>
      <span class="vertical-caption">SUZHOU · RUBY · MADE TO MEASURE</span>
    </div>
  </section>

  <!-- 2. COLLECTION SECTION WITH HORIZONTAL SCROLL & REALTIME SEARCH -->
  <section class="collection-section section-wrap" id="collection">
    <div class="section-heading">
      <div>
        <span class="eyebrow">THE COLLECTION · {text(lang,'좋아하는 순간을 입다','CLOTHED IN MOMENTS YOU LOVE')}</span>
        <h2>{text(lang,'전체 컬렉션','The Full Collection')}</h2>
      </div>
      <p>{text(lang,
        '모든 디자인은 수저우 실크 또는 루비 실크 중 원하는 소재와 컬러로 맞춤 제작할 수 있어요.',
        'Every design can be tailored in your choice of Suzhou or Ruby silk and favorite hue.'
      )}</p>
    </div>

    <!-- Collection Toolbar with Filter Pills & View Mode Toggle -->
    <div class="collection-toolbar">
      <div class="filters" role="group" aria-label={text(lang,'카테고리','Category')}>
        <button type="button" data-filter="all" aria-pressed="true">{text(lang,'전체','All pieces')}</button>
        <button type="button" data-filter="linen" aria-pressed="false">{text(lang,'린넨','Linen')}</button>
        {Object.entries(categoryNames).map(([key,label])=><button type="button" data-filter={key} aria-pressed="false">{label[lang] || label.en}</button>)}
      </div>
      <div class="toolbar-right">
        <span class="collection-count"><span data-visible-count>{catalog.designs.length}</span> {text(lang,'가지 디자인','designs')}</span>
        <div class="view-mode-toggle" role="group" aria-label="View mode">
          <button type="button" class="view-btn active" data-view="grid" title={text(lang, '그리드 보기', 'Grid view')}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="8" height="8" rx="1"></rect><rect x="13" y="3" width="8" height="8" rx="1"></rect><rect x="3" y="13" width="8" height="8" rx="1"></rect><rect x="13" y="13" width="8" height="8" rx="1"></rect></svg>
            <span>{text(lang, '그리드', 'Grid')}</span>
          </button>
          <button type="button" class="view-btn" data-view="scroll" title={text(lang, '가로 스크롤 보기', 'Horizontal scroll view')}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="6" height="14" rx="1"></rect><rect x="10" y="5" width="6" height="14" rx="1"></rect><rect x="18" y="5" width="6" height="14" rx="1"></rect></svg>
            <span>{text(lang, '가로 스크롤', 'Scroll')}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Collection Product Display (Grid View by Default, Scroll View Optional) -->
    <div class="horizontal-scroll-section grid-view" id="horizontalScrollSection">
      <button type="button" class="scroll-chevron-btn prev" id="scrollPrevBtn" aria-label="Scroll left">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="product-horizontal-track" id="productTrack">
        {catalog.designs.map((product,index)=><ProductCard product={product} lang={lang} index={index}/>)}
      </div>

      <button type="button" class="scroll-chevron-btn next" id="scrollNextBtn" aria-label="Scroll right">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <!-- Expand / Collapse All Designs Button for Grid Mode -->
    <div class="collection-expand-wrapper" id="collectionExpandWrapper">
      <button 
        type="button" 
        class="view-all-designs-btn" 
        id="toggleAllDesignsBtn"
        data-expand-text={text(lang, `전체 ${catalog.designs.length}개 디자인 모두 보기 ∨`, `View All ${catalog.designs.length} Designs ∨`)}
        data-collapse-text={text(lang, '간략히 보기 (처음 16개만 보기) ∧', 'Show Less (First 16 Designs) ∧')}
      >
        <span class="btn-text" id="toggleAllDesignsText">{text(lang, `전체 ${catalog.designs.length}개 디자인 모두 보기 ∨`, `View All ${catalog.designs.length} Designs ∨`)}</span>
      </button>
    </div>

    <!-- Scroll Progress Indicator (Visible in Scroll Mode) -->
    <div class="scroll-indicator-bar" id="scrollIndicatorBar">
      <div class="scroll-indicator-thumb" id="scrollIndicatorThumb"></div>
    </div>

    <!-- Search Empty State -->
    <div class="search-empty-state" id="searchEmptyState" hidden>
      <p class="empty-title">{text(lang, '일치하는 디자인이 없습니다', 'No designs match your search')}</p>
      <p class="empty-sub">{text(lang, '다른 검색어로 검색해 보시거나 필터를 초기화해 보세요.', 'Try searching with different keywords or reset your filters.')}</p>
      <button type="button" class="button secondary reset-search-btn" id="resetSearchBtn">
        {text(lang, '검색 초기화', 'Reset search')}
      </button>
    </div>
  </section>

  <!-- 3. SILK & COLOR CHARTS: SUZHOU & RUBY (Directly below collection) -->
  <section class="charts-showcase-section section-wrap" id="color-charts">
    <div class="section-heading">
      <div>
        <span class="eyebrow">100% PURE SILK & COLOR PALETTES · {text(lang,'실크 원단 & 공식 컬러 차트','SILK PALETTES')}</span>
        <h2>{text(lang,'수저우 실크 & 루비 실크 공식 컬러 차트','Exclusive Suzhou & Ruby Silk Color Palettes')}</h2>
      </div>
      <p>{text(lang,
        '미셸의 모든 드레스는 고객님의 체형 치수에 맞춰 100% 프리미엄 실크(수저우 / 루비)와 40여 가지 컬러 중 원하는 조합으로 맞춤 제작됩니다.\n각 원단의 고유한 광택과 텍스처, 추천 실루엣을 확인해 보세요.',
        'Every Michelle dress is made-to-measure tailored to your exact measurements in your choice of Suzhou or Ruby silk and 40+ curated color shades.\nDiscover each silk’s unique luster, hand-feel, and silhouette suitability.'
      )}</p>
    </div>

    <!-- Dual Color Chart Cards -->
    <div class="charts-dual-grid">
      <!-- Suzhou Silk Card -->
      <div class="chart-showcase-card">
        <a class="chart-image-wrap" href={sitePath(`/${lang}/fabrics/#suzhou`)} title={text(lang, '수저우 실크 컬러차트 상세보기', 'View Suzhou Silk Palette')}>
          <Image src={sourceImage('assets/fabrics/suzhou/chart-bilingual.jpg')} width={1200} format="webp" alt="Suzhou Silk Palette" loading="lazy" />
          <div class="chart-zoom-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
            <span>{text(lang, '고해상도 차트 보기', 'View High-Res Chart')}</span>
          </div>
        </a>
        <div class="chart-card-body">
          <span class="chart-badge">SUZHOU SILK · 100% PURE SILK</span>
          <h3>{text(lang, '수저우 실크 공식 컬러 차트', 'Suzhou Silk Premium Palette')}</h3>
          <p class="chart-card-lead">{text(lang, '은은하고 자연스러운 광택과 극상의 부드러움', 'Subtle natural sheen & supreme silky softness')}</p>
          <ul class="chart-specs-list">
            <li>
              <span class="spec-label">{text(lang, '원단 촉감', 'Feel & Texture')}</span>
              <span>{text(lang, '피부에 닿았을 때 자극 없이 매우 부드럽고 가벼우며 쾌적한 통기성', 'Exceptionally gentle, featherlight, and breathable on sensitive skin')}</span>
            </li>
            <li>
              <span class="spec-label">{text(lang, '드레이프', 'Drape & Fit')}</span>
              <span>{text(lang, '몸의 곡선을 따라 자연스럽고 유려하게 흘러내리는 내추럴 실루엣', 'Soft fluid drape that contours naturally to body curves')}</span>
            </li>
            <li>
              <span class="spec-label">{text(lang, '추천 드레스', 'Best For')}</span>
              <span>{text(lang, '카울넥 슬립 드레스(ML-01), U넥 슬립 맥시(ML-06), 홀터넥 드레스(ML-02)', 'Cowl neck slip dress (ML-01), Scoop slip maxi (ML-06), Halter maxi (ML-02)')}</span>
            </li>
            <li>
              <span class="spec-label">{text(lang, '컬러 구성', 'Shades')}</span>
              <span>{text(lang, '01 펄 화이트, 04 밀크 화이트, 76 올리브 그린, 61 와인 버건디 등 24가지', '24 shades incl. 01 Pearl White, 04 Milk White, 76 Olive, 61 Wine')}</span>
            </li>
          </ul>
          <div class="chart-card-footer">
            <a class="text-link" href={sitePath(`/${lang}/fabrics/#suzhou`)}>
              {text(lang, '수저우 실크 컬러북 전체보기', 'Explore Suzhou Silk Library')} ↗
            </a>
          </div>
        </div>
      </div>

      <!-- Ruby Silk Card -->
      <div class="chart-showcase-card">
        <a class="chart-image-wrap" href={sitePath(`/${lang}/fabrics/#ruby`)} title={text(lang, '루비 실크 컬러차트 상세보기', 'View Ruby Silk Palette')}>
          <Image src={sourceImage('assets/fabrics/ruby/chart-bilingual.jpg')} width={1200} format="webp" alt="Ruby Silk Palette" loading="lazy" />
          <div class="chart-zoom-badge">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
            <span>{text(lang, '고해상도 차트 보기', 'View High-Res Chart')}</span>
          </div>
        </a>
        <div class="chart-card-body">
          <span class="chart-badge">RUBY SILK · 100% PURE SILK</span>
          <h3>{text(lang, '루비 실크 공식 컬러 차트', 'Ruby Silk Premium Palette')}</h3>
          <p class="chart-card-lead">{text(lang, '선명한 럭셔리 윤기와 탄탄한 실루엣 유지', 'Luminous luxury luster & structured shape retention')}</p>
          <ul class="chart-specs-list">
            <li>
              <span class="spec-label">{text(lang, '원단 촉감', 'Feel & Texture')}</span>
              <span>{text(lang, '도톰하고 묵직한 무게감으로 안정적인 피팅감과 구김 없는 탄력', 'Substantial luxury weight, crisp touch, and wrinkle-resistant elasticity')}</span>
            </li>
            <li>
              <span class="spec-label">{text(lang, '드레이프', 'Drape & Fit')}</span>
              <span>{text(lang, '원단의 탄탄한 힘으로 드레스 핏(form)을 정돈되고 우아하게 유지', 'Holds structural silhouette firmly with regal elegance')}</span>
            </li>
            <li>
              <span class="spec-label">{text(lang, '추천 드레스', 'Best For')}</span>
              <span>{text(lang, '백리스 파티 실크 드레스(ML-05), 롱슬리브 카울넥 드레스(ML-09), 격식 있는 파티 & 웨딩', 'Backless party gown (ML-05), Long-sleeve cowl dress (ML-09), Evening galas')}</span>
            </li>
            <li>
              <span class="spec-label">{text(lang, '컬러 구성', 'Shades')}</span>
              <span>{text(lang, '01 퓨어 화이트, 11 골드, 28 파우더 핑크, 80 와인 버건디, 16 블랙 등 24가지', '24 rich shades incl. 01 Pure White, 11 Gold, 28 Powder Pink, 80 Wine, 16 Black')}</span>
            </li>
          </ul>
          <div class="chart-card-footer">
            <a class="text-link" href={sitePath(`/${lang}/fabrics/#ruby`)}>
              {text(lang, '루비 실크 컬러북 전체보기', 'Explore Ruby Silk Library')} ↗
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Bespoke Ordering Guidance Note -->
    <div class="chart-order-tip">
      <span class="chart-order-tip-icon">💡</span>
      <div class="chart-order-tip-content">
        <strong>{text(lang, '맞춤 제작 실크 & 컬러 선택 안내', 'How to Choose Your Silk & Color Code')}</strong>
        <p>{text(lang,
          '마음에 드는 드레스 디자인을 선택하신 후, 주문서(제안서) 또는 인스타그램 1:1 상담 시 원하시는 원단 종류(수저우 실크 / 루비 실크)와 컬러 번호(예: 수저우 04번 밀크 화이트 또는 루비 80번 와인 버건디)를 알려주세요. 고객님의 키, 가슴, 허리, 엉덩이 치수에 맞춰 한 분만을 위한 전담 테일러가 정성껏 수작업으로 완성해 드립니다.',
          'Choose your favorite dress design, then specify your preferred fabric (Suzhou Silk / Ruby Silk) and color code (e.g., Suzhou No. 04 Milk White or Ruby No. 80 Wine Burgundy) in your order proposal or Instagram consultation. Our master tailors will meticulously handcraft your dress to your exact height and body measurements.'
        )}</p>
      </div>
    </div>
  </section>

  <!-- 4. BESPOKE PROCESS: 4 STEPS (From user chat screenshot) -->
  <section class="how-section section-wrap" id="how-it-works">
    <div class="section-heading">
      <div>
        <span class="eyebrow">MADE TO MEASURE · {text(lang,'사이즈 맞춤 제작 과정','BESPOKE PROCESS')}</span>
        <h2>{text(lang,'사이즈 맞춤 제작 과정 (4단계)','Made to Measure in 4 Steps')}</h2>
      </div>
      <p>{text(lang,
        '선택한 디자인을, 내 신체 치수에 딱 맞게.\n상담부터 배송까지 세심하게 제작됩니다.',
        'Your chosen design, crafted perfectly to your personal measurements.\nFrom initial consultation to doorstep delivery.'
      )}</p>
    </div>
    <div class="steps-grid-4">
      <div class="step-card">
        <span class="step-num">01</span>
        <h3>{text(lang,'디자인 선택','Choose Design')}</h3>
        <p>{text(lang,
