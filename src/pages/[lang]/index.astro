---
import {sitePath} from '../../lib/paths';
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import {getCatalog} from '../../lib/catalog';
import {text,locales,categoryNames} from '../../lib/i18n';
import type {Locale} from '../../lib/types';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Locale;
const catalog=await getCatalog();

// 4 high-fashion model designs for the auto-sliding hero
const heroSlugs = [
  'minimal-long-sleeve-cowl-neck',
  'scoop-neck-slip-maxi',
  'minimal-cowl-neck-slip-dress',
  'halter-maxi'
];

const heroSlides = heroSlugs
  .map(slug => catalog.designs.find(d => d.slug === slug))
  .filter((d): d is typeof catalog.designs[0] => Boolean(d));

if (heroSlides.length < 4) {
  for (const d of catalog.designs) {
    if (!heroSlides.some(s => s.id === d.id)) {
      heroSlides.push(d);
      if (heroSlides.length >= 4) break;
    }
  }
}

const second = heroSlides[1] ?? catalog.designs[1];
const detail = catalog.designs.find(d => d.slug === 'slim-fit-blouse') ?? heroSlides[0];
---
<Layout lang={lang} title={text(lang,'사이즈 맞춤 실크 컬렉션','Made-to-measure silk collection')}>
  <!-- Schema.org CollectionPage & ItemList Structured Data for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": text(lang, "미셸 스토어 사이즈 맞춤 실크 컬렉션", "Michelle Store Made-to-measure Silk Collection"),
    "description": text(lang, "수저우 실크와 루비 실크로 맞춤 제작되는 미셸의 드레스, 블라우스, 트라우저 컬렉션.", "Michelle's collection of custom made-to-measure dresses, blouses, and trousers in luxury silk."),
    "url": new URL(sitePath(`/${lang}/`), Astro.site || 'https://michellestore.com').toString(),
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": catalog.designs.length,
      "itemListElement": catalog.designs.map((design, idx) => ({
        "@type": "ListItem",
        "position": idx + 1,
        "name": design.name[lang] || design.name.en,
        "url": new URL(sitePath(`/${lang}/designs/${design.slug}/`), Astro.site || 'https://michellestore.com').toString(),
        "image": new URL(design.imageUrl, Astro.site || 'https://michellestore.com').toString()
      }))
    }
  })} />

  <!-- 1. AUTO-SLIDING HERO BANNER WITH 4 MODELS -->
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">SILK, MADE TO MEASURE · {text(lang,'사이즈 맞춤 제작','BESPOKE SILK')}</span>
      <h1>
        {text(lang,'미셸의 디자인,','Michelle’s designs,')}<br/>
        {text(lang,'나에게 맞는 사이즈.','made to your size.')}
      </h1>
      <p class="hero-script">Silk, made to measure.</p>
      <p class="hero-description">
        {text(lang,
          '미셸의 컬렉션에서 디자인과 실크, 컬러를 고르세요.\n선택하신 디자인을 고객님의 신체 치수에 맞춰 제작해 드려요.',
          'Choose a design from Michelle’s collection, along with your silk and color.\nYour selected piece is made to your measurements.',
          'Lựa chọn thiết kế từ bộ sưu tập của Michelle, chọn chất liệu lụa Tô Châu hoặc Ruby cùng bảng màu ưng ý.\nTrang phục sẽ được may đo chuẩn xác theo từng số đo cơ thể của bạn.'
        )}
      </p>
      <div class="hero-actions">
        <a class="button primary hero-button" href="#collection">
          {text(lang,'컬렉션 살펴보기','Explore collection','Xem bộ sưu tập')}<span>↗</span>
        </a>
        <a class="button secondary hero-sub-button" href="#care-guide">
          {text(lang,'원단 관리 가이드','Fabric care guide','Hướng dẫn bảo quản')}
        </a>
      </div>
      <div class="hero-footnote">
        <span class="fine-line"></span>
        <span>{text(lang,'미셸의 컬렉션에서 고르고, 사이즈는 나에게 맞게','Choose from the collection. Made to your measurements.','Đồ lụa may đo theo số đo · Đồ linen may sẵn theo size')}</span>
      </div>
    </div>
    
    <div class="hero-visual">
      <div class="hero-carousel" id="heroCarousel">
        <div class="hero-slides-track" id="heroTrack">
          {heroSlides.map((slide, idx) => (
            <a class="hero-slide" href={sitePath(`/${lang}/designs/${slide.slug}/`)} aria-label={slide.name[lang] || slide.name.en}>
              <img 
                src={slide.imageUrl} 
                width="1000" 
                height="1333" 
                fetchpriority={idx === 0 ? "high" : "auto"} 
                loading={idx === 0 ? "eager" : "lazy"} 
                alt={slide.name[lang] || slide.name.en}
              />
              <span class="photo-caption">
                <span>0{idx + 1} / {slide.name[lang] || slide.name.en}</span>
                <span>{text(lang, '디자인 보기', 'EXPLORE', 'CHI TIẾT')} ↗</span>
              </span>
            </a>
          ))}
        </div>
        
        <button type="button" class="hero-nav-btn prev" id="heroPrevBtn" aria-label="Previous slide">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="hero-nav-btn next" id="heroNextBtn" aria-label="Next slide">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>

        <div class="hero-indicators" id="heroIndicators">
          {heroSlides.map((_, idx) => (
            <button type="button" class={`hero-indicator-btn ${idx === 0 ? 'active' : ''}`} data-index={idx} aria-label={`Slide ${idx + 1}`}>
              <span class="ind-number">0{idx + 1}</span>
              <span class="ind-bar"><span class="ind-progress"></span></span>
            </button>
          ))}
        </div>
      </div>

      <a class="hero-inset" href={sitePath(`/${lang}/designs/${second.slug}/`)}>
        <img src={second.thumbnailUrl} width="480" height="640" alt={second.name[lang] || second.name.en}/>
        <span>{text(lang,'나를 닮은 한 벌','A piece of you','Thiết kế tinh tế')} ↗</span>
      </a>
      <span class="vertical-caption">SUZHOU · RUBY · MADE TO MEASURE</span>
    </div>
  </section>

  <!-- 2. COLLECTION SECTION WITH HORIZONTAL SCROLL & REALTIME SEARCH -->
  <section class="collection-section section-wrap" id="collection">
    <div class="section-heading">
      <div>
        <span class="eyebrow">THE COLLECTION · {text(lang,'컬렉션','COLLECTION')}</span>
        <h2>{text(lang,'좋아하는 순간을 입다','Find your silhouette')}</h2>
      </div>
      <p>{text(lang,
        '미셸의 디자인 중 마음에 드는 한 벌을 고르세요.\n실크와 컬러를 선택하고, 사이즈는 나에게 맞추세요.',
        'Find your favorite design in Michelle’s collection.\nChoose your silk and color, with sizing made for you.',
        'Đồ lụa cao cấp được may đo chuẩn xác theo từng số đo cơ thể; Đồ linen may sẵn theo size chuẩn S·M·L. Chọn chất liệu lụa Tô Châu hoặc Ruby và màu sắc bạn thích.'
      )}</p>
    </div>

    <!-- Search Input Bar -->
    <div class="collection-search-container">
      <div class="search-input-wrapper">
        <svg class="search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input 
          type="search" 
          id="collectionSearchInput" 
          class="collection-search-input" 
          placeholder={text(lang, '디자인 이름, 번호(ML-01), 실크 검색...', 'Search designs, code (ML-01), silk type...', 'Tìm kiếm theo tên thiết kế, mã số (ML-01), loại vải lụa...')} 
          autocomplete="off" 
        />
        <button type="button" id="clearSearchBtn" class="clear-search-btn" aria-label="Clear search" hidden>✕</button>
      </div>
    </div>

    <!-- Collection Toolbar with Filter Pills & View Mode Toggle -->
    <div class="collection-toolbar">
      <div class="filters" role="group" aria-label={text(lang,'카테고리','Category','Phân loại')}>
        <button type="button" data-filter="all" aria-pressed="true">{text(lang,'전체','All pieces','Tất cả')}</button>
        {Object.entries(categoryNames).map(([key,label])=><button type="button" data-filter={key} aria-pressed="false">{label[lang] || label.en}</button>)}
      </div>
      <div class="toolbar-right">
        <span class="collection-count"><span data-visible-count>{catalog.designs.length}</span> {text(lang,'가지 디자인','designs','mẫu thiết kế')}</span>
        <div class="view-mode-toggle" role="group" aria-label="View mode">
          <button type="button" class="view-btn active" data-view="scroll" title={text(lang, '가로 스크롤 보기', 'Horizontal scroll view', 'Xem cuộn ngang')}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="6" height="14" rx="1"></rect><rect x="10" y="5" width="6" height="14" rx="1"></rect><rect x="18" y="5" width="6" height="14" rx="1"></rect></svg>
            <span>{text(lang, '가로 스크롤', 'Scroll', 'Cuộn ngang')}</span>
          </button>
          <button type="button" class="view-btn" data-view="grid" title={text(lang, '그리드 보기', 'Grid view', 'Xem dạng lưới')}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="8" height="8" rx="1"></rect><rect x="13" y="3" width="8" height="8" rx="1"></rect><rect x="3" y="13" width="8" height="8" rx="1"></rect><rect x="13" y="13" width="8" height="8" rx="1"></rect></svg>
            <span>{text(lang, '그리드', 'Grid', 'Lưới')}</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Horizontal Scroll Section with Chevrons -->
    <div class="horizontal-scroll-section" id="horizontalScrollSection">
      <button type="button" class="scroll-chevron-btn prev" id="scrollPrevBtn" aria-label="Scroll left">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="product-horizontal-track" id="productTrack">
        {catalog.designs.map((product,index)=><ProductCard product={product} lang={lang} index={index}/>)}
      </div>

      <button type="button" class="scroll-chevron-btn next" id="scrollNextBtn" aria-label="Scroll right">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <!-- Scroll Progress Indicator -->
    <div class="scroll-indicator-bar" id="scrollIndicatorBar">
      <div class="scroll-indicator-thumb" id="scrollIndicatorThumb"></div>
    </div>

    <!-- Search Empty State -->
    <div class="search-empty-state" id="searchEmptyState" hidden>
      <p class="empty-title">{text(lang, '일치하는 디자인이 없습니다', 'No designs match your search', 'Không tìm thấy thiết kế phù hợp')}</p>
      <p class="empty-sub">{text(lang, '다른 검색어로 검색해 보시거나 필터를 초기화해 보세요.', 'Try searching with different keywords or reset your filters.', 'Hãy thử tìm kiếm với từ khóa khác hoặc đặt lại bộ lọc.')}</p>
      <button type="button" class="button secondary reset-search-btn" id="resetSearchBtn">
        {text(lang, '검색 초기화', 'Reset search', 'Đặt lại tìm kiếm')}
      </button>
    </div>
  </section>

  <!-- 3. FABRIC STORY & 2 SILK CHARACTERISTICS (SUZHOU & RUBY) -->
  <section class="fabric-story section-wrap">
    <div class="fabric-story-art">
      <img src={detail.imageUrl} loading="lazy" width="1000" height="1300" alt={detail.name[lang] || detail.name.en}/>
      <span class="fabric-art-label">THE BEAUTY IS IN THE DETAIL.</span>
    </div>
    <div class="fabric-story-copy">
      <span class="eyebrow">SILK & COLOR · {text(lang,'실크 & 컬러','FABRICS & COLORS')}</span>
      <h2>
        {text(lang,'같은 디자인도,','The same silhouette,')}<br/>
        {text(lang,'나만의 분위기로.','a different feeling.')}
      </h2>
      <p>{text(lang,
        '수저우 실크는 은은한 광택과 부드러운 감촉을, 루비 실크는 선명한 윤기와 탄탄한 실루엣을 선사합니다.\n차분한 아이보리부터 깊은 올리브, 와인까지 40여 가지 컬러북에서 나만의 조합을 찾아보세요.',
        'Suzhou silk offers a gentle sheen and soft drape, while Ruby silk provides luminous luster and structured silhouette.\nFrom quiet ivory to deep olive, find your shade across our curated palette.'
      )}</p>
      <div class="editorial-swatches" aria-hidden="true">
        {catalog.fabrics[0].colors.filter(c=>['04','14','76','103','16','61'].includes(c.id)).map(color=><span style={`--swatch:${color.hex}`}></span>)}
      </div>
      <a class="text-link" href={sitePath(`/${lang}/fabrics/`)}>
        {text(lang,'실크와 컬러 만나보기','Discover the silks & colors')} ↗
      </a>
    </div>
  </section>

  <!-- 4. BESPOKE PROCESS: 4 STEPS (From user chat screenshot) -->
  <section class="how-section section-wrap" id="how-it-works">
    <div class="section-heading">
      <div>
        <span class="eyebrow">MADE TO MEASURE · {text(lang,'사이즈 맞춤 제작 과정','BESPOKE PROCESS')}</span>
        <h2>{text(lang,'사이즈 맞춤 제작 과정 (4단계)','Made to Measure in 4 Steps')}</h2>
      </div>
      <p>{text(lang,
        '선택한 디자인을, 내 신체 치수에 딱 맞게.\n상담부터 배송까지 세심하게 제작됩니다.',
        'Your chosen design, crafted perfectly to your personal measurements.\nFrom initial consultation to doorstep delivery.',
        'Mỗi bộ trang phục lụa được may đo riêng theo số đo thực tế của bạn.\nQuy trình tư vấn tận tâm trực tiếp cùng Michelle.'
      )}</p>
    </div>
    <div class="steps-grid-4">
      <div class="step-card">
        <span class="step-num">01</span>
        <h3>{text(lang,'디자인 선택','Choose Design','Chọn mẫu thiết kế')}</h3>
        <p>{text(lang,
          '미셸의 컬렉션에서 마음에 드는 디자인(드레스, 탑, 트라우저)을 선택해 주세요.',
          'Browse Michelle’s collection and pick your favorite silhouette.',
          'Lựa chọn mẫu đầm, áo hoặc quần yêu thích từ bộ sưu tập của Michelle Store.'
        )}</p>
      </div>
      <div class="step-card">
        <span class="step-num">02</span>
        <h3>{text(lang,'원단 & 컬러 선택','Silk & Color','Chọn lụa & màu sắc')}</h3>
        <p>{text(lang,
          '수저우 실크 또는 루비 실크를 고르고, 공식 컬러차트에서 원하는 색상 코드를 확인합니다.',
          'Choose between Suzhou or Ruby silk and pick your desired shade from the color chart.',
          'Chọn Lụa Tô Châu mềm rủ hoặc Lụa Ruby giữ form, tra cứu mã màu trong bảng màu 2048px.'
        )}</p>
      </div>
      <div class="step-card">
        <span class="step-num">03</span>
        <h3>{text(lang,'상세 치수 측정','Measurements','Tư vấn lấy số đo')}</h3>
        <p>{text(lang,
          '가슴, 허리, 엉덩이둘레와 키, 몸무게를 편안한 상태에서 측정하여 알려주세요.',
          'Share your bust, waist, hips measurements, along with height and weight.',
          'Đo 3 vòng ngực, eo, mông cùng chiều cao, cân nặng theo hướng dẫn để may vừa vặn nhất.'
        )}</p>
      </div>
      <div class="step-card">
        <span class="step-num">04</span>
        <h3>{text(lang,'주문 확인 & 배송','Confirm & Delivery','Xác nhận & Giao hàng')}</h3>
        <p>{text(lang,
          '인스타그램 @michelle1998kr로 최종 상담을 진행합니다. 제작 약 7일, 배송 약 5~6일이 소요됩니다.',
          'Confirm with Michelle on Instagram @michelle1998kr. Tailoring takes ~7 days, delivery ~5-6 days.',
          'Xác nhận đơn qua Instagram @michelle1998kr. Thời gian may khoảng 7 ngày, vận chuyển khoảng 5–6 ngày.'
        )}</p>
      </div>
    </div>
  </section>

  <!-- 5. DETAILED MEASUREMENT GUIDE (From user chat screenshot) -->
  <section class="measurement-guide-section section-wrap" id="measurement-guide">
    <div class="section-heading">
      <div>
        <span class="eyebrow">MEASUREMENT GUIDE · {text(lang,'신체 치수 측정 안내','MEASUREMENT GUIDE')}</span>
        <h2>{text(lang,'신체 치수 측정 안내','How to Take Your Measurements')}</h2>
      </div>
      <p>{text(lang,
        '정확한 신체 치수를 알려주시면 가장 완벽하고 편안한 핏으로 제작해 드립니다.',
        'Providing accurate measurements ensures your garment fits you gracefully and comfortably.'
      )}</p>
    </div>

    <div class="measure-points-grid">
      <div class="measure-point-card">
        <div class="measure-card-media">
          <img src={sitePath('/measure/bust.png')} width="800" height="500" loading="lazy" alt="Bust measurement guide" />
          <span class="measure-badge">01</span>
        </div>
        <div class="measure-card-body">
          <h4>{text(lang, '가슴둘레 (Bust)', 'Bust Measurement')}</h4>
          <p>{text(lang, '가슴의 가장 볼록한 부분을 줄자로 둘러 편안하게 측정합니다.', 'Measure around the fullest part of your bust comfortably.')}</p>
        </div>
      </div>
      <div class="measure-point-card">
        <div class="measure-card-media">
          <img src={sitePath('/measure/waist.png')} width="800" height="500" loading="lazy" alt="Waist measurement guide" />
          <span class="measure-badge">02</span>
        </div>
        <div class="measure-card-body">
          <h4>{text(lang, '허리둘레 (Waist)', 'Waist Measurement')}</h4>
          <p>{text(lang, '배꼽 위 약 3cm, 가장 잘록한 허리 부분을 측정합니다.', 'Measure around your natural waist, roughly 3cm above the navel.')}</p>
        </div>
      </div>
      <div class="measure-point-card">
        <div class="measure-card-media">
          <img src={sitePath('/measure/hips.png')} width="800" height="500" loading="lazy" alt="Hips measurement guide" />
          <span class="measure-badge">03</span>
        </div>
        <div class="measure-card-body">
          <h4>{text(lang, '엉덩이둘레 (Hips)', 'Hips Measurement')}</h4>
          <p>{text(lang, '엉덩이의 가장 넓고 볼록한 부분을 수평으로 측정합니다.', 'Measure around the widest part of your hips and buttocks.')}</p>
        </div>
      </div>
      <div class="measure-point-card">
        <div class="measure-card-media">
          <img src={sitePath('/measure/height.jpg')} width="800" height="500" loading="lazy" alt="Height and proportions guide" />
          <span class="measure-badge">04</span>
        </div>
        <div class="measure-card-body">
          <h4>{text(lang, '키 & 몸무게 & 특이사항', 'Height, Weight & Notes')}</h4>
          <p>{text(lang, '키와 몸무게를 함께 알려주시고, 어깨가 넓거나 팔이 긴 경우 메모를 남겨주세요.', 'Share your height & weight. Note if your shoulders or arms have special proportions.')}</p>
        </div>
      </div>
    </div>

    <div class="measure-tip-box">
      <strong>💡 {text(lang, '치수 측정 팁', 'Measurement Tip')}:</strong>
      <span>{text(lang,
        '줄자를 너무 조이거나 헐겁지 않게, 편안하게 숨을 쉴 수 있는 상태에서 측정해 주세요. 치수를 임의로 늘리거나 줄이지 마시고 실제 신체 치수를 알려주세요.',
        'Keep the measuring tape snug but not tight—you should breathe normally. Please do not add or subtract inches.'
      )}</span>
    </div>
  </section>

