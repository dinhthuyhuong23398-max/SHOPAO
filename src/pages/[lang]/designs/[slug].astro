---
import {sitePath} from '../../../lib/paths';
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import DesignPosts from '../../../components/DesignPosts.astro';
import ProductCustomizer from '../../../components/ProductCustomizer';
import {getCatalog,designs} from '../../../lib/catalog';
import {priceLabel} from '../../../lib/shop';
import {text,locales,categoryNames} from '../../../lib/i18n';
import type {Locale} from '../../../lib/types';
export function getStaticPaths(){return locales.flatMap(lang=>designs.map(design=>({params:{lang,slug:design.slug}})));}
const lang=Astro.params.lang as Locale;
const catalog=await getCatalog();
const product=catalog.designs.find(d=>d.slug===Astro.params.slug)!;
const related=catalog.designs.filter(d=>d.category===product.category&&d.id!==product.id).slice(0,3);
const pName = product.name[lang] || product.name.en || product.name.ko;
const pDesc = product.description[lang] || product.description.en || product.description.ko;
const catName = categoryNames[product.category]?.[lang] || categoryNames[product.category]?.en;
const isLinen = product.slug.includes('linen') || ['ml-31', 'ml-32', 'ml-33', 'ml-34'].includes(product.id.toLowerCase());
---
<Layout lang={lang} title={pName} description={pDesc}>
  <!-- Schema.org Product & BreadcrumbList Structured Data for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": pName,
    "description": pDesc,
    "image": new URL(product.imageUrl, Astro.site || 'https://michellestore.com').toString(),
    "sku": product.id,
    "category": catName,
    "brand": {
      "@type": "Brand",
      "name": "Michelle Store"
    },
    "material": isLinen ? "100% Premium Natural Linen" : "Silk (Suzhou / Ruby)",
    "offers": {
      "@type": "Offer",
      "url": new URL(Astro.url.pathname, Astro.site || 'https://michellestore.com').toString(),
      "priceCurrency": "KRW",
      "price": product.priceMin || 0,
      "priceValidUntil": "2027-12-31",
      "availability": "https://schema.org/InStock",
      "itemCondition": "https://schema.org/NewCondition",
      "seller": {
        "@type": "Organization",
        "name": "Michelle Store"
      }
    }
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": text(lang, "컬렉션", "Collection"),
        "item": new URL(sitePath(`/${lang}/#collection`), Astro.site || 'https://michellestore.com').toString()
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": catName,
        "item": new URL(sitePath(`/${lang}/#collection`), Astro.site || 'https://michellestore.com').toString()
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": pName,
        "item": new URL(Astro.url.pathname, Astro.site || 'https://michellestore.com').toString()
      }
    ]
  })} />

  <div class="breadcrumb section-wrap">
    <a href={sitePath(`/${lang}/#collection`)}>{text(lang,'컬렉션','Collection')}</a>
    <span>/</span>
    <span>{catName}</span>
  </div>
  <section class="product-detail section-wrap">
    <div class="detail-photograph">
      <div class="main-photo-wrapper">
        <img id="mainProductPhoto" src={product.imageUrl} width="1000" height="1333" alt={pName} fetchpriority="high"/>
      </div>
      {product.galleryUrls && product.galleryUrls.length > 0 && (
        <div class="photo-gallery-strip" role="group" aria-label={text(lang, '제품 갤러리', 'Product photo gallery')}>
          <button 
            type="button" 
            class="gallery-thumb-btn active" 
            data-img-src={product.imageUrl} 
            aria-label={text(lang, '메인 사진', 'Main photo')}
          >
            <img src={product.thumbnailUrl} alt={pName} />
          </button>
          {product.galleryUrls.map((gUrl, idx) => (
            <button 
              type="button" 
              class="gallery-thumb-btn" 
              data-img-src={gUrl} 
              aria-label={text(lang, `상세 사진 ${idx + 1}`, `Photo ${idx + 2}`)}
            >
              <img src={gUrl} alt={`${pName} - ${idx + 1}`} />
            </button>
          ))}
        </div>
      )}
      <div class="image-caption">
        <span>{product.id} / {catName}</span>
        <span>{text(lang,'디자인 참고 사진','Design reference')}</span>
      </div>
      <p class="field-hint">
        {isLinen ? text(lang,
          '사진은 디자인 참고용이며 실제 제품은 100% 천연 린넨으로 제작됩니다. 코디된 다른 의류와 액세서리는 선택에 포함되지 않아요.',
          'This photograph shows the design in 100% natural linen. Other styled garments and accessories are not included.',
          'Hình ảnh thể hiện phom dáng thiết kế mẫu từ chất liệu 100% linen tự nhiên cao cấp.'
        ) : text(lang,
          '사진은 디자인 참고용이며 선택하신 컬러로 자동 변경되지 않아요. 코디된 다른 의류와 액세서리는 선택에 포함되지 않아요.',
          'This photograph shows the design and does not change with your color choice. Other styled garments and accessories are not included.',
          'Hình ảnh thể hiện phom dáng thiết kế mẫu. Sản phẩm thực tế sẽ được may theo đúng chất liệu lụa, màu sắc và số đo bạn đã chọn.'
        )}
      </p>
    </div>
    <div class="detail-content">
      <span class="eyebrow">{isLinen ? text(lang, 'READY TO WEAR (기성복)', 'READY TO WEAR', 'HÀNG MAY SẴN') : text(lang, 'MADE TO MEASURE', 'MADE TO MEASURE', 'MAY ĐO THEO SỐ ĐO')} · {product.id}</span>
      <h1>{pName}</h1>
      <p class="detail-description">{pDesc}</p>
      <p class="detail-price">{priceLabel(product,lang)}</p>
      <p class="field-hint">
        {isLinen ? text(lang,
          '100% 프리미엄 내추럴 린넨으로 제작된 기성복 컬렉션입니다. 표준 기성 사이즈(XS, S, M, L)로 제작되어 빠르게 받아보실 수 있습니다.',
          '100% premium natural linen ready-to-wear collection. Available in standard sizes XS, S, M, L.',
          'Sản phẩm thuộc bộ sưu tập Linen may sẵn cao cấp theo bảng size chuẩn (XS, S, M, L).'
        ) : text(lang,
          '선택하신 디자인을 고객님의 신체 치수에 맞춰 제작해 드려요. 최종 가격과 제작 가능 여부는 상담 시 확인해 주세요.',
          'This design is made to your measurements. Michelle will confirm final pricing and availability with you.',
          'Thiết kế này được may đo theo số đo của bạn. Thời gian may khoảng 7 ngày, vận chuyển khoảng 5–6 ngày.'
        )}
      </p>
      <ProductCustomizer product={product} catalog={catalog} lang={lang} client:load/>
      <details class="product-details">
        <summary>{isLinen ? text(lang, '린넨 기성복 사이즈 & 관리 안내', 'Ready-to-wear size & care guide', 'Hướng dẫn chọn size & bảo quản linen') : text(lang,'사이즈 맞춤 제작 안내','Made-to-measure details')} <span>+</span></summary>
        <p>{isLinen ? text(lang,
          '미셸의 린넨 컬렉션은 100% 천연 린넨 소재로 제작된 프리미엄 기성복입니다. 표준 기성 사이즈(XS, S, M, L) 중 선택하실 수 있으며, 세탁 시 미온수 울코스 또는 단독 손세탁을 권장합니다.',
          'Michelle’s linen collection is crafted from 100% natural premium linen in standard ready-to-wear sizes (XS, S, M, L). Hand wash or gentle machine wash recommended.',
          'Bộ sưu tập Linen của Michelle được may sẵn theo bảng size chuẩn từ chất liệu 100% linen tự nhiên thoáng mát, phom dáng thanh lịch. Giặt tay nhẹ nhàng hoặc giặt máy chế độ êm để giữ độ bền đẹp.'
        ) : text(lang,
          '미셸의 컬렉션에 있는 디자인을 선택하고 실크와 컬러, 신체 치수를 담아 제안서를 만들어 주세요. 선택하신 디자인의 사이즈를 고객님의 치수에 맞춰 제작하며, 인스타그램 상담을 통해 사이즈와 최종 가격, 제작 일정을 확인해 드려요. 이곳에서 결제되거나 주문이 확정되지는 않아요.',
          'Choose an existing design from Michelle’s collection, select your silk and color, then add your measurements to the proposal. Your selected design is made to your size. Michelle will confirm sizing, final pricing and production timing on Instagram. This site does not take payment or confirm an order.'
        )}</p>
      </details>
    </div>
  </section>
  <DesignPosts reviews={product.reviews} lang={lang}/>
  <section class="section-wrap related-section">
    <div class="section-heading">
      <div>
        <span class="eyebrow">ALSO IN THE EDIT</span>
        <h2>{text(lang,'함께 살펴볼 디자인','More to fall for')}</h2>
      </div>
    </div>
    <div class="product-grid related-grid">
      {related.map(product=><ProductCard product={product} lang={lang}/>)}
    </div>
  </section>

  <script>
    document.querySelectorAll('.gallery-thumb-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.gallery-thumb-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const newSrc = btn.getAttribute('data-img-src');
        const mainImg = document.getElementById('mainProductPhoto') as HTMLImageElement | null;
        if (mainImg && newSrc) {
          mainImg.src = newSrc;
        }
      });
    });
  </script>
  <style>
    .detail-description {
      white-space: pre-line;
      line-height: 1.8;
    }
  </style>
</Layout>
