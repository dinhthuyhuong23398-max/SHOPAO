---
import {sitePath,routePath} from '../lib/paths';
import '../styles/global.css';
import '@fontsource-variable/cormorant-garamond';
import '@fontsource-variable/noto-sans-kr';
import type {Locale} from '../lib/types';
import {text} from '../lib/i18n';
import {settings} from '../lib/catalog';
import FloatingWidgets from '../components/FloatingWidgets';
interface Props { lang:Locale; title?:string; description?:string; notFound?:boolean; }
const { lang, title = 'Michelle Store', description, notFound = false } = Astro.props;
const fullTitle = title === 'Michelle Store'
  ? text(lang, '미셸 스토어 (Michelle Store) | 프리미엄 사이즈 맞춤 실크 컬렉션', 'Michelle Store | Made-to-Measure Bespoke Silk Collection')
  : `${title} | Michelle Store`;
const fullDescription = description || text(lang, '미셸 스토어 - 프리미엄 수저우 실크 & 루비 실크 100% 맞춤 제작. 고객님의 신체 치수에 맞춰 정교하게 제작되는 오뜨 꾸뛰르 사이즈 맞춤 실크 컬렉션.', 'Michelle Store - Bespoke luxury silk collection crafted in authentic Suzhou and Ruby silk. Made to your unique measurements with personalized atelier tailoring.');
const isNotFound = notFound === true;
const path = isNotFound ? '/' : routePath(Astro.url.pathname).replace(/^\/(ko|en)(?=\/|$)/,'') || '/';
const siteOrigin = Astro.site?.origin || 'https://michellestore.com';
const canonicalUrl = new URL(sitePath(`/${lang}${path === '/' ? '' : path}`), siteOrigin);
const ogImageUrl = new URL(sitePath('/brand/michelle-logo.png'), siteOrigin).toString();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#f6f4ee" />
    <title>{fullTitle}</title>
    <meta name="description" content={fullDescription} />
    <meta name="keywords" content={text(lang, '미셸 스토어, 사이즈 맞춤 실크, 수저우 실크, 루비 실크, 실크 드레스, 실크 블라우스, 맞춤 원피스, Michelle Store, 실크 슬립 드레스', 'Michelle Store, bespoke silk, made to measure silk, suzhou silk, ruby silk, custom silk dress, luxury silk tailoring')} />
    <meta name="author" content="Michelle Store" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    
    <!-- Canonical & Alternate Hreflang URLs (Google Multi-lingual SEO Standard) -->
    <link rel="canonical" href={canonicalUrl} />
    {!notFound && (
      <>
        <link rel="alternate" hreflang="ko" href={new URL(sitePath(`/ko${path}`), siteOrigin)} />
        <link rel="alternate" hreflang="en" href={new URL(sitePath(`/en${path}`), siteOrigin)} />
        <link rel="alternate" hreflang="x-default" href={new URL(sitePath(`/ko${path}`), siteOrigin)} />
      </>
    )}

    <!-- Open Graph (Facebook, KakaoTalk, Zalo, LinkedIn) -->
    <meta property="og:site_name" content="Michelle Store" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={fullDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={fullDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href={sitePath("/favicon.svg")} />

    <!-- Schema.org JSON-LD Structured Data for Google Rich Snippets -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "ClothingStore",
          "@id": "https://michellestore.com/#organization",
          "name": "Michelle Store",
          "url": "https://michellestore.com/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://michellestore.com/brand/michelle-logo.png"
          },
          "image": "https://michellestore.com/brand/michelle-logo.png",
          "description": text(lang, "미셸의 디자인과 프리미엄 수저우·루비 실크로 제작하는 1:1 사이즈 맞춤 실크 컬렉션.", "Bespoke silk collection crafted in luxurious Suzhou and Ruby silk. Made to your unique measurements."),
          "sameAs": [
            `https://www.instagram.com/${settings.instagram}/`,
            `https://www.threads.com/@${settings.threads}`
          ],
          "priceRange": "$$$$"
        },
        {
          "@type": "WebSite",
          "@id": "https://michellestore.com/#website",
          "url": "https://michellestore.com/",
          "name": "Michelle Store",
          "inLanguage": ["ko", "en"],
          "publisher": { "@id": "https://michellestore.com/#organization" },
          "potentialAction": {
            "@type": "SearchAction",
            "target": "https://michellestore.com/ko/?q={search_term_string}#collection",
            "query-input": "required name=search_term_string"
          }
        }
      ]
    })} />
  </head>
  <body>
    <a href="#main" class="skip-link">{text(lang,'본문으로 이동','Skip to content')}</a>
    <div class="announcement">{text(lang,'미셸의 실크, 나에게 맞는 사이즈로','SILK, MADE TO YOUR MEASUREMENTS')}<span>SUZHOU & RUBY</span></div>
    <header class="site-header">
      <a class="brand" href={sitePath(`/${lang}/`)} aria-label="Michelle Store"><img src={sitePath("/brand/michelle-logo.png")} width="834" height="390" alt="ML Michelle Store" /></a>
      <nav class="main-nav" aria-label={text(lang,'메인 메뉴','Main navigation')}>
        <a href={sitePath(`/${lang}/#collection`)}>{text(lang,'컬렉션','Collection')}</a>
        <a href={sitePath(`/${lang}/?q=linen#collection`)} data-nav-linen>{text(lang,'린넨','Linen')}</a>
        <a href={sitePath(`/${lang}/fabrics/`)}>{text(lang,'실크 & 컬러','Silk & color')}</a>
        <a href={sitePath(`/${lang}/#how-it-works`)}>{text(lang,'사이즈 맞춤 안내','Made to measure')}</a>
        <a href={sitePath(`/${lang}/#care-guide`)}>{text(lang,'관리 가이드','Care guide')}</a>
      </nav>
      <div class="header-search-bar" id="headerSearchBar">
        <div class="header-search-form" id="headerSearchForm" role="search">
          <svg class="header-search-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="search" 
            id="headerSearchInput" 
            class="header-search-input" 
            placeholder={text(lang, '디자인 이름, 번호(ML-01), 실크 검색...', 'Search designs, code (ML-01), silk...')} 
            autocomplete="off" 
          />
          <button type="button" id="headerClearBtn" class="header-clear-btn" aria-label="Clear search" hidden>✕</button>
        </div>
      </div>
      <div class="header-tools">
        <div class="language-switch" aria-label="Language">
          <a data-language href={sitePath(`/ko${path}`)} lang="ko" aria-current={lang==='ko'?'page':undefined}>KR</a>
          <span>/</span>
          <a data-language href={sitePath(`/en${path}`)} lang="en" aria-current={lang==='en'?'page':undefined}>EN</a>
        </div>
        <a class="bag-link" href={sitePath(`/${lang}/selections/`)} aria-label={text(lang,'나의 선택','My selections')}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M8 9V6a4 4 0 0 1 8 0v3"/></svg><span class="bag-count" data-bag-count>0</span>
        </a>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-top"><div><span class="eyebrow light">MICHELLE STORE</span><p class="footer-statement">Made for <em>you.</em></p></div><div class="footer-message"><p>{text(lang,'미셸의 디자인, 내가 고른 컬러.\n내 치수에 맞춰 제작하는 한 벌.','Michelle’s designs. Your chosen color.\nMade to your measurements.')}</p><div class="footer-social-links"><a class="text-link light social-pill" href={`https://www.instagram.com/${settings.instagram}/`} target="_blank" rel="noopener noreferrer"><svg class="social-icon-svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg> Instagram @{settings.instagram} ↗</a><a class="text-link light social-pill" href={`https://www.threads.com/@${settings.threads}`} target="_blank" rel="noopener noreferrer"><svg class="social-icon-svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 5.044 3.73 9.217 8.57 9.882.164.022.327.037.49.049.31.022.62.034.94.034.32 0 .63-.012.94-.034.163-.012.326-.027.49-.049C18.27 21.217 22 17.044 22 12c0-5.523-4.477-10-10-10zm0 18.067c-.247 0-.49-.01-.734-.027-.123-.01-.245-.02-.367-.034C7.26 19.467 4 16.12 4 12c0-4.411 3.589-8 8-8s8 3.589 8 8c0 4.12-3.26 7.467-6.899 7.973-.122.014-.244.024-.367.034-.244.017-.487.027-.734.027zm1.196-12.788c-2.38 0-4.086 1.637-4.086 3.921 0 2.457 1.83 4.025 4.316 4.025 1.488 0 2.808-.592 3.587-1.611l-1.393-.974c-.53.649-1.336 1.01-2.194 1.01-1.458 0-2.528-.888-2.553-2.316h6.398c.041-.219.062-.444.062-.676 0-2.094-1.516-3.379-4.137-3.379zm-2.318 3.25c.108-.94.943-1.666 2.193-1.666 1.189 0 2.016.702 2.138 1.666h-4.331z"/></svg> Threads @{settings.threads} ↗</a></div></div></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Michelle Store</span><span>{text(lang,'사이즈 맞춤 제작 · 최종 가격은 상담 후 안내','Made to measure · Final pricing confirmed in consultation')}</span><a href={sitePath(`/${lang}/privacy/`)}>{text(lang,'저장 정보 안내','Your saved information')}</a></div>
    </footer>
    <FloatingWidgets lang={lang} instagram={settings.instagram} sheetId={settings.sheetId} orderApiUrl={settings.orderApiUrl} client:load />
    <script>
      import {CART_KEY,parseCart} from '../lib/shop';
      function updateCount(){
        try {const raw=localStorage.getItem(CART_KEY);const count=raw?parseCart(JSON.parse(raw)).items.reduce((n,i)=>n+i.quantity,0):0;document.querySelectorAll('[data-bag-count]').forEach(el=>el.textContent=String(count));}catch{}
      }
      updateCount();
      window.addEventListener('storage',updateCount);
      window.addEventListener('michelle:cart-updated',updateCount);

      // Header Search Bar navigation and instant sync
      const headerSearchInput = document.getElementById('headerSearchInput') as HTMLInputElement | null;
      const headerClearBtn = document.getElementById('headerClearBtn');

      if (headerSearchInput) {
        headerSearchInput.addEventListener('input', () => {
          const val = headerSearchInput.value;
          if (headerClearBtn) headerClearBtn.hidden = !val;
          window.dispatchEvent(new CustomEvent('michelle:search-input', { detail: { query: val } }));
        });

        const performSearchSubmit = () => {
          const val = headerSearchInput.value.trim();
          const currentPath = window.location.pathname;
          const isHome = currentPath.endsWith('/ko/') || currentPath.endsWith('/en/') || currentPath.endsWith('/ko') || currentPath.endsWith('/en') || currentPath === '/';
          if (isHome) {
            const coll = document.getElementById('collection');
            coll?.scrollIntoView({ behavior: 'smooth' });
          } else {
            const lang = document.documentElement.lang || 'ko';
            window.location.href = `/${lang}/?q=${encodeURIComponent(val)}#collection`;
          }
        };

        headerSearchInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            performSearchSubmit();
          }
        });

        headerClearBtn?.addEventListener('click', () => {
          headerSearchInput.value = '';
          headerClearBtn.hidden = true;
          window.dispatchEvent(new CustomEvent('michelle:search-input', { detail: { query: '' } }));
          headerSearchInput.focus();
        });
      }
    </script>
  </body>
</html>
